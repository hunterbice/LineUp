{
  "name": "LineUp",
  "short_name": "LineUp",
  "description": "Know the move before you move. Check Tucson bar crowds, line waits, maps, active deals, and rewards from your phone.",
  "id": "/",
  "start_url": "/index.html?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "window-controls-overlay", "minimal-ui", "browser"],
  "orientation": "portrait",
  "background_color": "#F5F7FB",
  "theme_color": "#F5F7FB",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "categories": ["social", "lifestyle", "navigation"],
  "icons": [
    {
      "src": "icons/favicon-32.png",
      "sizes": "32x32",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Live Status",
      "short_name": "Live",
      "description": "Open the live bar feed.",
      "url": "/index.html?source=shortcut-live",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Map",
      "short_name": "Map",
      "description": "Open the Tucson bar map.",
      "url": "/index.html?source=shortcut-map&page=mapPage",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Active Deals",
      "short_name": "Deals",
      "description": "Open active venue deals.",
      "url": "/index.html?source=shortcut-deals&page=highlightsPage",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
